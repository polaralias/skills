{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaralias.dev/schemas/repo-context-manifest-1.json",
  "title": "Polaralias repository-context knowledge bindings",
  "type": "object",
  "required": ["schemaVersion", "knowledge"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "knowledge": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledgeBinding"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "knowledgeBinding": {
      "type": "object",
      "required": ["path", "sources"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verified": {
          "$ref": "#/$defs/verificationReceipt"
        }
      },
      "additionalProperties": true
    },
    "verificationReceipt": {
      "type": "object",
      "required": ["verifiedAt", "evidence"],
      "oneOf": [
        {"required": ["sourceIdentities"]},
        {"required": ["sourceHashes"]}
      ],
      "properties": {
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "sourceHashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "sourceIdentities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  }
}
